# MongoDB Connection URI
# For local MongoDB
MONGO_URI=mongodb://localhost:27017/ticket-generator

# For MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ticket-generator

# Server Port
PORT=5000

# JWT Secret Key (change this to a strong secret)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Environment
NODE_ENV=development

# Allowed frontend origin(s) for CORS, comma-separated (no trailing slash)
# e.g. CLIENT_URL=https://your-app.vercel.app
# Leave unset locally to allow all origins
# CLIENT_URL=

# WhatsApp Integration - Meta Cloud API (Optional)
# WHATSAPP_TOKEN=your_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_TEMPLATE_NAME=event_ticket
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_COUNTRY_CODE=91

# Email Configuration (Optional)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
